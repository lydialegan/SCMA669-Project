#---------------------------
# Product-level weekly series (bottom level)
# ---------------------------
weekly_by_item <- All_weeks %>%
  mutate(SALES_DATE = as.Date(SALES_DATE)) %>%
  group_by(SALES_DATE, ITEM_DESCRIPTION) %>%            # 1) aggregate first
  summarise(
    weekly_sales = sum(SALE_AMOUNT, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  as_tsibble(                                           # 2) now safe to tsibble
    key   = ITEM_DESCRIPTION,
    index = SALES_DATE
  )

# ---------------------------
# Hierarchical tsibble by ITEM_DESCRIPTION
# (Total + each individual product)
# ---------------------------
weekly_hts <- weekly_by_item %>%
  aggregate_key(
    ITEM_DESCRIPTION,                                   # 3) creates "all items" + each ITEM_DESCRIPTION
    weekly_sales = sum(weekly_sales)
  )
#---------------------------
# 7. Fit models to each series in the hierarchy
#    (each ITEM_DESCRIPTION + the aggregated Total)
#---------------------------
fit_hts <- weekly_hts %>%
  model(
    ARIMA_manual = ARIMA(weekly_sales ~ pdq(0,1,0)),
    ETS_ANN      = ETS(weekly_sales ~ error("A") + trend("N") + season("N"))
  )

# Reconciled hierarchical forecasts using bottom-up ARIMA
fc_hts <- fit_hts %>%
  reconcile(
    bu = bottom_up(ARIMA_manual)
  ) %>%
  forecast(h = 4)

#---------------------------
# 8. Plot: top-level reconciled forecast (hierarchical Total)
#---------------------------
fc_total_hts <- fc_hts %>%
  filter(.model == "bu", is_aggregated(ITEM_DESCRIPTION))

autoplot(
  weekly_hts %>% filter(is_aggregated(ITEM_DESCRIPTION)),
  weekly_sales
) +
  autolayer(fc_total_hts, level = c(80, 95)) +
  labs(
    title    = "Hierarchical Forecast: Total Weekly Sales",
    subtitle = "Bottom-up ARIMA(0,1,0) reconciled across ITEM_DESCRIPTION",
    x        = "Week Ending Date",
    y        = "Weekly Sales"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

