concatenating weekly dataframes
```{r}
All_weeks <- rbind(
  target_week_1, target_week_2_1, target_week_2_2, target_week_3_1, target_week_3_2,
  target_week_4_1, target_week_4_2, target_week_4_3, target_week_5
)
```


Collapse duplicates at (LOCATION_ID, TCIN, SALES_DATE)
```{r}
weekly_base <- All_weeks %>%
  mutate(SALES_DATE = as.Date(SALES_DATE)) %>%
  group_by(LOCATION_ID, TCIN, SALES_DATE) %>%
  summarise(
    total_qty = sum(SALE_QUANTITY, na.rm = TRUE),
    .groups = "drop"
  )

  
```

Weekly tsibble at the bottom level
```{r}
weekly_ts <- weekly_base %>%
  as_tsibble(
    key   = c(LOCATION_ID, TCIN),
    index = SALES_DATE
  )
```


Hierarchical aggregation: Total -> Location -> (Location, TCIN)
```{r}
weekly_hts <- weekly_ts %>%
  aggregate_key(
    LOCATION_ID / TCIN,
    total_qty = sum(total_qty, na.rm = TRUE)
  )
```


Top-level series for plotting / storytelling
```{r}
weekly_top <- weekly_hts %>%
  filter(is_aggregated(LOCATION_ID), is_aggregated(TCIN))

autoplot(weekly_top, total_qty) +
  geom_point(size = 2) +
  labs(
    title    = "Weekly Total Quantity for Target Ice Cream Sandwiches",
    subtitle = "Aggregated across all locations and products",
    x        = "Week Ending Date",
    y        = "Weekly Quantity"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
```


Fit weekly models for the entire hierarchy
```{r}
# Fit models on top-level weekly total quantity
fit_top <- weekly_top %>%
  model(
    ARIMA    = ARIMA(total_qty),
    ETS      = ETS(total_qty),
    TSLM     = TSLM(total_qty ~ trend()),
    Ensemble = (ARIMA(total_qty) +
                  ETS(total_qty) +
                  TSLM(total_qty ~ trend())) / 3
  )
report(fit_top %>% select(ARIMA))
report(fit_top %>% select(ETS))
report(fit_top %>% select(TSLM))

```


Rolling-origin cross-validation on top-level weekly series
```{r}
cv_top <- weekly_top %>%
  stretch_tsibble(.init = 3, .step = 1) %>%   # first 3 weeks as initial window
  model(
    ARIMA    = ARIMA(total_qty),
    ETS      = ETS(total_qty),
    TSLM     = TSLM(total_qty ~ trend()),
    Ensemble = (ARIMA(total_qty) +
                  ETS(total_qty) +
                  TSLM(total_qty ~ trend())) / 3
  ) %>%
  forecast(h = 1)                             # always forecast 1 week ahead

```



Compute CV accuracy metrics
```{r}
cv_results <- cv_top %>%
  accuracy(weekly_top) %>%
  group_by(.model) %>%
  summarise(
    RMSE = mean(RMSE, na.rm = TRUE),
    MAPE = mean(MAPE, na.rm = TRUE)
  )

